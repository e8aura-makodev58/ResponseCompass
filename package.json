{
  "name": "response-compass",
  "version": "0.1.0",
  "private": true,
  "description": "Manufacturing control-room dispatch agent (synthetic demo).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "start": "node dist/src/index.js",
    "dev": "nodemon --watch src --ext ts --exec \"npm run build && node dist/src/index.js\"",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "nodemon": "^3.1.14",
    "typescript": "5.9.3"
  }
}
